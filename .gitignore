# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.claude/
.qoder/

# 环境变量（含 API Key 等敏感信息，.env 同时覆盖 frontend/.env）
.env

# ---- 后端 ----
# 预训练模型（约 3.2GB，通过 DOC_EXTRACT_PRETRAINED_MODELS 配置，需单独下载）
backend/document_extract/pretrained_models/
# 运行时 SQLite 数据库（含 WAL/SHM 侧车文件）
backend/document_extract/cache.db*
backend/document_extract/users.db*
backend/agent/sessions.db*
backend/agent/kb.db*
backend/agent/skill.db*
# 知识库 RAG 运行时数据（向量库 / 元数据 / 原始文件）
backend/agent/kb_qdrant/
backend/agent/kb_files/
# Skill 系统运行时数据（SKILL.md 文件目录）
backend/agent/skills/
# 上传与输出目录
backend/*/uploads/
backend/document_compare/tmp_imgs/
backend/document_compare/compare_results/
# 运行时生成的向量索引
backend/multimodel/indices/
# 模型权重（CLIP / InsightFace，由框架下载，约 1.1GB）
backend/multimodel/models/
# 多模态样本库（图片/音频/文本/缩略图，约 165MB）
backend/multimodel/repositories/
# Agent 运行时工作区
backend/agent/workspace/
# 长期记忆（每用户独立子目录）
backend/agent/memory/
# 日志
backend/logs/
# 样本/测试数据
backend/document_compare/data/
backend/document_extract/data/
# pip 安装误生成的文件
backend/=*

# ---- 前端 ----
frontend/node_modules/
frontend/dist/

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store

**/材料/
