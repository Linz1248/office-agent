# ============================================================
# office-agent 环境变量配置
# 使用方法：复制此文件为 .env，填入实际值
#   cp .env.example .env
# 启动时 start_all.sh 会自动加载 .env
# ============================================================

# ── LLM API Key ──────────────────────────────────────────────
# 默认使用 DeepSeek，如需切换提供商请修改 backend/agent/config.py 中的 LLM_PROVIDER
DEEPSEEK_API_KEY=sk-6ea235bce33c44788d5dc5f4035def73

# 如使用其他提供商，取消注释并填写：
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# ── 服务间鉴权 ───────────────────────────────────────────────
# JWT 签名密钥（Agent Service 与 document_extract 共享，必须一致）
DOC_EXTRACT_SECRET_KEY=document-extract-key

# document_extract 服务账号密码（MCP Server 调用时使用）
SERVICE_ACCOUNT_PASSWORD=123456
