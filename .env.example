# ============================================================
# office-agent 环境变量配置
# 使用方法：复制此文件为 .env，填入实际值
#   cp .env.example .env
# 启动时 start_all.sh 会自动加载 .env
# ============================================================

# ── LLM API Key ──────────────────────────────────────────────
# 默认使用 DeepSeek，如需切换提供商请修改 backend/agent/config.py 中的 LLM_PROVIDER
DEEPSEEK_API_KEY=xxxx

# 如使用其他提供商，取消注释并填写：
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# ── 服务间鉴权 ───────────────────────────────────────────────
# JWT 签名密钥（Agent Service 与 document_extract 共享，必须一致）
DOC_EXTRACT_SECRET_KEY=document-extract-key

# document_extract 服务账号密码（MCP Server 调用时使用）
SERVICE_ACCOUNT_PASSWORD=123456

# ── 记忆图谱（memory_graph，无 Docker 原生部署，不使用 PG）────────
# 详见 backend/agent/memory_graph/README.md 与 .env.example。
# 以下均为默认值（沿用默认可省略）；唯一必需外部服务 Neo4j 的安装：
#   cd backend && ./install_memory_infra.sh install && ./install_memory_infra.sh start
# MEMORY_GRAPH_NEO4J_URI=bolt://localhost:7687
# MEMORY_GRAPH_NEO4J_USER=neo4j
# MEMORY_GRAPH_NEO4J_PASSWORD=officeagent
# 审计库默认 SQLite（backend/agent/memory_graph.db），无需配置；不使用 PG。
# 反思增量计数优先 Redis（已安装启动即生效），不可用回退 SQLite：
# MEMORY_GRAPH_REDIS_URL=redis://localhost:6379/0
# 需要 Celery 队列（高并发/多实例）时：MEMORY_GRAPH_CELERY_ENABLED=true
#   并启动 backend/run_memory_worker.sh（broker=RabbitMQ，result backend=Redis）
#   RabbitMQ 安装：cd backend && ./install_rabbitmq.sh install && ./install_rabbitmq.sh start
# Embedding 维度须与 Ollama 模型一致（默认 qwen3-embedding:8b = 4096）：
# MEMORY_GRAPH_EMBEDDING_DIMS=4096

# ── 飞书会议（自动接收 / 子 agent 分析 / 待办提醒）────────────────
# 用户在「飞书会议」页配置各自的飞书自建应用凭证（App ID/Secret/Open ID），
# 无需在此配置。以下为服务级参数，均可省略（默认值见 backend/agent/config.py）：
#   MEETING_SYNC_INTERVAL       同步轮询间隔秒数（默认 300）
#   MEETING_SYNC_LOOKBACK_DAYS  回看窗口天数（默认 3，最多 90）
#   MEETING_REMIND_LEAD_MINUTES 待办提前提醒分钟数（默认 30）
# 会议知识库复用 KB 的 Ollama 嵌入（qwen3-embedding:8b），无需额外配置。

# ── 邮件通知（可选；用户在页面启用邮件后仍需此处 SMTP 才能外发）────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=notice@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=notice@example.com
# SMTP_USE_SSL=true
