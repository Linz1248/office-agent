# 记忆图谱模块环境变量（前缀 MEMORY_GRAPH_）。
# 将需要的项追加到项目根目录 /root/code/office-agent/.env（start_all.sh 会 source 它）。
# 默认值即为「无 Docker」形态：审计库 SQLite、无 Redis/Celery；唯一外部服务是 Neo4j。

# 总开关：置 False 则模块整体旁路（is_ready()=False）
MEMORY_GRAPH_ENABLED=true

# Neo4j（图谱：实体/陈述/关系/事件/社区/洞察 + 向量 + 全文）
# 无 Docker 原生部署：cd backend && ./install_memory_infra.sh install && ./install_memory_infra.sh start
# （有 Docker 的环境也可用 docker-compose.memory-graph.yml）
MEMORY_GRAPH_NEO4J_URI=bolt://localhost:7687
MEMORY_GRAPH_NEO4J_USER=neo4j
MEMORY_GRAPH_NEO4J_PASSWORD=officeagent

# 审计库（来源原文 / 萃取审计 / 人工纠错 / 反思计数）
# 默认 SQLite，零配置；留空路径则落在 backend/agent/memory_graph.db
# 需要 PostgreSQL 时设 MEMORY_GRAPH_AUDIT_BACKEND=postgres 并配置下方连接参数
MEMORY_GRAPH_AUDIT_BACKEND=sqlite
# MEMORY_GRAPH_AUDIT_SQLITE_PATH=/path/to/memory_graph.db
# MEMORY_GRAPH_POSTGRES_HOST=localhost
# MEMORY_GRAPH_POSTGRES_PORT=5432
# MEMORY_GRAPH_POSTGRES_USER=officeagent
# MEMORY_GRAPH_POSTGRES_PASSWORD=officeagent
# MEMORY_GRAPH_POSTGRES_DB=officeagent

# Redis / RabbitMQ / Celery
# 反思增量计数 + 缓存优先 Redis（INCRBY 等），不可用回退 SQLite；Redis 已启动即生效。
MEMORY_GRAPH_REDIS_URL=redis://localhost:6379/0
# 缓存层（飞书 token / 嵌入 / 抽取幂等等易失数据），供 agent/redis_utils 用
REDIS_CACHE_URL=redis://localhost:6379/3
# 萃取派发默认进程内 asyncio（零额外进程）；
# 需要队列（高并发/多实例）时置 true，并启动 backend/run_memory_worker.sh。
# broker=RabbitMQ（ACK/DLQ/重试更可靠），result backend 仍用 Redis。
MEMORY_GRAPH_CELERY_ENABLED=false
# MEMORY_GRAPH_CELERY_BROKER_URL=amqp://officeagent:officeagent@localhost:5672/officeagent
# MEMORY_GRAPH_CELERY_RESULT_BACKEND=redis://localhost:6379/2
# RabbitMQ 安装：cd backend && ./install_rabbitmq.sh install && ./install_rabbitmq.sh start

# Embedding：维度须与所用 embedding 模型输出维度一致。
# 默认复用知识库的 Ollama qwen3-embedding:8b（4096 维）。
# 若在 config.py 中改了 KB_EMBEDDING_DIM，这里也要同步改。
MEMORY_GRAPH_EMBEDDING_MODEL=qwen3-embedding:8b
MEMORY_GRAPH_EMBEDDING_OLLAMA_HOST=http://localhost:11434
MEMORY_GRAPH_EMBEDDING_DIMS=4096

# 控制模式：static_control / agent_control / both（默认 both）
MEMORY_GRAPH_CONTROL_MODE=both

# 主动召回超时（秒，默认 8.0）：召回慢时调大，避免对话跳过记忆注入。
# MEMORY_GRAPH_ACTIVE_RECALL_TIMEOUT=8.0
